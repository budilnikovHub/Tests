### CMakeLists.txt

```cmake
cmake_minimum_required(VERSION 3.18)
project(cuckoo_cuda LANGUAGES CXX CUDA)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CUDA_STANDARD 14)

add_executable(cuckoo_cuda src/main.cu)

# Optional: enable fast math if you want (not needed here)
# target_compile_options(cuckoo_cuda PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-use_fast_math>)

# Set relocation to static runtime if needed
if (MSVC)
  set_target_properties(cuckoo_cuda PROPERTIES CUDA_SEPARABLE_COMPILATION ON)
else()
  set_target_properties(cuckoo_cuda PROPERTIES POSITION_INDEPENDENT_CODE ON)
endif()

# Link/compile options to suppress warnings on some systems
if (NOT MSVC)
  target_compile_options(cuckoo_cuda PRIVATE -Wall -Wextra -Wno-unused-parameter)
endif()
```

